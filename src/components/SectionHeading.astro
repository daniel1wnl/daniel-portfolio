---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="mb-10 max-w-3xl sm:mb-12">
  {eyebrow && <p class="font-mono-display mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-blue-700">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold tracking-[-0.035em] text-zinc-950 sm:text-4xl">{title}</h2>
  {intro && <p class="mt-5 text-base leading-7 text-zinc-600 sm:text-lg sm:leading-8">{intro}</p>}
</div>
