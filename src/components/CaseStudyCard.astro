---
interface Props {
  title: string;
  type: string;
  visibility: string;
  tech: string[];
  description: string;
  impact?: string;
  dates: string;
  status: string;
  outcomeLabel?: string;
  technologiesLabel?: string;
}

const {
  title,
  type,
  visibility,
  tech,
  description,
  impact,
  dates,
  status,
  outcomeLabel = 'Outcome',
  technologiesLabel = 'Technologies'
} = Astro.props;
---

<article class="flex h-full flex-col rounded-lg border border-zinc-200 bg-white p-6 sm:p-7">
  <div class="font-mono-display flex flex-wrap items-center justify-between gap-2 text-[0.7rem] uppercase tracking-[0.12em] text-zinc-500">
    <span>{visibility}</span>
    <span>{type}</span>
  </div>
  <h3 class="mt-5 text-xl font-semibold leading-snug tracking-[-0.025em] text-zinc-950">{title}</h3>
  <p class="font-mono-display mt-2 text-xs leading-5 text-zinc-500">{dates} · {status}</p>
  <p class="mt-5 text-sm leading-6 text-zinc-600">{description}</p>

  {impact && (
    <div class="mt-6 border-l-2 border-[#FF2800] pl-4">
      <p class="font-mono-display text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-zinc-500">{outcomeLabel}</p>
      <p class="mt-2 text-sm leading-6 text-zinc-700">{impact}</p>
    </div>
  )}

  <ul aria-label={technologiesLabel} class="mt-auto flex flex-wrap gap-x-3 gap-y-2 pt-7">
    {tech.map((technology) => (
      <li class="font-mono-display text-[0.7rem] text-zinc-500">{technology}</li>
    ))}
  </ul>
</article>
