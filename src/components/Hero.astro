---
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).hero;
const primaryResume = locale === 'es' ? '/resume/Daniel-Gregorio-Torres-Resume-ES.pdf' : '/resume/Daniel-Gregorio-Torres-Resume.pdf';
const alternateResume = locale === 'es' ? '/resume/Daniel-Gregorio-Torres-Resume.pdf' : '/resume/Daniel-Gregorio-Torres-Resume-ES.pdf';
const primaryResumeLanguage = locale;
const alternateResumeLanguage = locale === 'es' ? 'en' : 'es';
---

<section aria-labelledby="hero-title" class="relative isolate min-h-[31rem] overflow-hidden bg-zinc-950 text-white sm:min-h-[35rem]">
  <picture class="absolute inset-0 -z-20 h-full w-full" aria-hidden="true">
    <source
      type="image/webp"
      srcset="/images/portland-hero-768.webp 768w, /images/portland-hero-1440.webp 1440w, /images/portland-hero-2560.webp 2560w"
      sizes="100vw"
    />
    <img
      src="/images/portland-hero.jpg"
      alt=""
      width="4048"
      height="3032"
      fetchpriority="high"
      class="h-full w-full object-cover object-[56%_52%] saturate-[0.72]"
    />
  </picture>
  <div class="absolute inset-0 -z-10 bg-zinc-950/70 sm:bg-zinc-950/45 sm:bg-gradient-to-r sm:from-zinc-950/70 sm:via-zinc-950/55 sm:to-zinc-950/20"></div>

  <div class="mx-auto flex min-h-[31rem] max-w-7xl items-center px-5 py-20 sm:min-h-[35rem] sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <p class="font-mono-display mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-zinc-300">{t.location}</p>
      <h1 id="hero-title" class="max-w-2xl text-4xl font-semibold leading-[1.08] tracking-[-0.045em] text-white sm:text-5xl lg:text-6xl">Daniel Gregorio-Torres</h1>
      <p class="mt-5 text-lg font-medium text-zinc-200 sm:text-xl">{t.role}</p>
      <p class="mt-6 max-w-2xl text-base leading-7 text-zinc-300 sm:text-lg sm:leading-8">{t.summary}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#work-projects" class="inline-flex min-h-11 items-center justify-center rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-[#FF2800]">{t.explore}</a>
        <a href={primaryResume} target="_blank" rel="noopener noreferrer" hreflang={primaryResumeLanguage} class="inline-flex min-h-11 items-center justify-center rounded-md border border-white/35 bg-zinc-950/25 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-[#FF2800] hover:bg-[#FF2800] hover:text-zinc-950">{t.resume}</a>
        <a href={alternateResume} target="_blank" rel="noopener noreferrer" hreflang={alternateResumeLanguage} class="inline-flex min-h-11 items-center justify-center rounded-md border border-white/25 bg-zinc-950/20 px-5 py-2.5 text-sm font-semibold text-zinc-200 transition-colors hover:border-[#FF2800] hover:bg-[#FF2800] hover:text-zinc-950">{t.resumeAlternate}</a>
      </div>

      <div class="font-mono-display mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-[0.14em] text-zinc-300">
        <a href="https://github.com/daniel1wnl" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-8 items-center transition-colors hover:text-[#FF2800]">GitHub</a>
        <a href="https://www.linkedin.com/in/danielgregoriotorres" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-8 items-center transition-colors hover:text-[#FF2800]">LinkedIn</a>
        <a href="#contact" class="inline-flex min-h-8 items-center transition-colors hover:text-[#FF2800]">{t.contact}</a>
      </div>

      <p class="mt-5 max-w-2xl text-sm leading-6 text-zinc-400">{t.personal}</p>
    </div>
  </div>

  <p class="absolute bottom-3 right-4 text-[0.65rem] text-white/80 sm:right-6">
    {t.photoBy} <a href="https://unsplash.com/@shenny_visuals" target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 underline-offset-2 transition-colors hover:text-[#FF2800]">Justin Shen</a> {t.photoOn} <a href="https://unsplash.com/photos/a-large-neon-sign-on-top-of-a-building-k0VeQ6sXHGg" target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 underline-offset-2 transition-colors hover:text-[#FF2800]">Unsplash</a>
  </p>
</section>
