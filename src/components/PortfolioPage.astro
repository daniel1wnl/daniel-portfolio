---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ProjectCard from './ProjectCard.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import SkillGroup from './SkillGroup.astro';
import SectionHeading from './SectionHeading.astro';
import { localizeCaseStudy, localizeProject } from '../i18n/content';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const primaryResume = locale === 'es' ? '/resume/Daniel-Gregorio-Torres-Resume-ES.pdf' : '/resume/Daniel-Gregorio-Torres-Resume.pdf';
const alternateResume = locale === 'es' ? '/resume/Daniel-Gregorio-Torres-Resume.pdf' : '/resume/Daniel-Gregorio-Torres-Resume-ES.pdf';
const primaryResumeLanguage = locale;
const alternateResumeLanguage = locale === 'es' ? 'en' : 'es';
const primaryResumeFilename = locale === 'es' ? 'Daniel-Gregorio-Torres-Resume-ES.pdf' : 'Daniel-Gregorio-Torres-Resume.pdf';

const projects = await getCollection('projects', ({ data }) => data.featured === true);
const caseStudies = await getCollection('case-studies', ({ data }) => data.featured === true);

const schoolProjects = projects.filter((project) => project.data.category === 'School / University');
const personalProjects = projects.filter((project) => project.data.category === 'Personal');
const workPriority = [
  'SafetyCheck',
  'Mobile SOP and Training Acknowledgement Portal',
  'Warehouse Inventory Tracking App',
  'IT Operations Automation'
];
const completedWork = caseStudies
  .filter((study) => !study.data.current)
  .sort((a, b) => workPriority.indexOf(a.data.title) - workPriority.indexOf(b.data.title));
const currentWork = caseStudies.filter((study) => study.data.current);

const localizedSchoolProjects = schoolProjects.map((project) => localizeProject(project.data, locale));
const localizedPersonalProjects = personalProjects.map((project) => localizeProject(project.data, locale));
const localizedCompletedWork = completedWork.map((study) => localizeCaseStudy(study.data, locale));
const localizedCurrentWork = currentWork.map((study) => localizeCaseStudy(study.data, locale));

const credentialUrls = [
  'https://www.credential.net/d5c287ef-5859-4de5-81e1-039377d2f609#acc.G2DnvjO3',
  'https://www.credential.net/97ce4aa2-99d3-4365-9dbf-cbbb423643b4#acc.PEl3Q7Uo',
  'https://www.credential.net/557f8a88-302f-4e70-bff1-672f41ed74d5#acc.fs2LP41i',
];
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />

  <section id="work-projects" class="border-y border-zinc-200 bg-zinc-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading title={t.work.title} intro={t.work.intro} />

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {localizedCompletedWork.map((study) => (
          <CaseStudyCard
            title={study.title}
            type={study.type}
            visibility={study.visibility}
            tech={study.tech}
            description={study.description}
            impact={study.impact}
            dates={study.dates}
            status={study.status}
            outcomeLabel={t.cards.outcome}
            technologiesLabel={t.cards.technologies}
          />
        ))}
      </div>

      <div class="mt-16 border-t border-zinc-300 pt-12 sm:mt-20">
        <div class="mb-8 max-w-3xl">
          <p class="font-mono-display mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#D52200]">{t.work.currentEyebrow}</p>
          <h3 class="text-2xl font-semibold tracking-[-0.03em] text-zinc-950 sm:text-3xl">{t.work.currentTitle}</h3>
          <p class="mt-4 leading-7 text-zinc-600">{t.work.currentIntro}</p>
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {localizedCurrentWork.map((study) => (
            <CaseStudyCard
              title={study.title}
              type={study.type}
              visibility={study.visibility}
              tech={study.tech}
              description={study.description}
              impact={study.impact}
              dates={study.dates}
              status={study.status}
              outcomeLabel={t.cards.outcome}
              technologiesLabel={t.cards.technologies}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="border-b border-zinc-200 bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading title={t.experience.title} />

      <ol class="relative max-w-6xl border-l border-zinc-300">
        <li class="relative pb-16 pl-7 sm:grid sm:grid-cols-[11rem_1fr] sm:gap-8 sm:pl-10">
          <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-[#FF2800] ring-4 ring-white"></span>
          <p class="font-mono-display mb-3 text-xs leading-5 text-zinc-500 sm:mb-0">{t.experience.streimer.dates}</p>
          <div>
            <h3 class="text-xl font-semibold tracking-[-0.025em] text-zinc-950">{t.experience.streimer.title}</h3>
            <p class="mt-1 text-sm font-medium text-zinc-600">{t.experience.streimer.organization}</p>
            <ul class="mt-6 grid gap-x-8 gap-y-4 text-sm leading-6 text-zinc-600 lg:grid-cols-2">
              {t.experience.streimer.bullets.map((bullet) => (
                <li><strong class="font-semibold text-zinc-800">{bullet.label}</strong> {bullet.text}</li>
              ))}
            </ul>
          </div>
        </li>
        <li class="relative pl-7 sm:grid sm:grid-cols-[11rem_1fr] sm:gap-8 sm:pl-10">
          <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-zinc-500 ring-4 ring-white"></span>
          <p class="font-mono-display mb-3 text-xs leading-5 text-zinc-500 sm:mb-0">{t.experience.igrafx.dates}</p>
          <div>
            <h3 class="text-xl font-semibold tracking-[-0.025em] text-zinc-950">{t.experience.igrafx.title}</h3>
            <p class="mt-1 text-sm font-medium text-zinc-600">{t.experience.igrafx.organization}</p>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-zinc-600">
              {t.experience.igrafx.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section id="education" class="border-b border-zinc-200 bg-zinc-50 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading title={t.education.title} />

      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
        <article>
          <p class="font-mono-display text-xs font-semibold uppercase tracking-[0.16em] text-[#D52200]">{t.education.degreeLabel}</p>
          <h3 class="mt-3 text-xl font-semibold tracking-[-0.025em] text-zinc-950">{t.education.degree}</h3>
          <p class="mt-1 text-sm font-medium text-zinc-600">{t.education.minor}</p>
          <div class="font-mono-display mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-zinc-500">
            <span>{t.education.university}</span>
            <span>{t.education.location}</span>
            <span>{t.education.graduation}</span>
          </div>
        </article>

        <article class="border-t border-zinc-200 pt-7 lg:border-l lg:border-t-0 lg:pl-14 lg:pt-0">
          <p class="font-mono-display text-xs font-semibold uppercase tracking-[0.16em] text-[#D52200]">{t.education.developmentLabel}</p>
          <h3 class="mt-3 text-xl font-semibold tracking-[-0.025em] text-zinc-950">{t.education.program}</h3>
          <p class="mt-1 text-sm font-medium text-zinc-600">{t.education.programDates}</p>
          <ul aria-label={t.education.credentialsLabel} class="mt-5 space-y-2 text-sm">
            {t.education.credentials.map((credential, index) => (
              <li>
                <a href={credentialUrls[index]} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-8 items-center gap-2 text-zinc-700 transition-colors hover:text-[#D52200]">
                  {credential} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section id="workshop" class="border-b border-zinc-200 bg-white py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16 lg:px-10">
      <div>
        <p class="font-mono-display mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#D52200]">{t.workshop.eyebrow}</p>
        <h2 class="text-3xl font-semibold tracking-[-0.035em] text-zinc-950 sm:text-4xl">{t.workshop.title}</h2>
        <p class="font-mono-display mt-4 text-xs text-zinc-500">{t.workshop.dates}</p>
      </div>
      <div>
        <p class="text-lg leading-8 text-zinc-700">{t.workshop.summary}</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {t.workshop.highlights.map((item) => (
            <p class="border-l-2 border-zinc-300 pl-4 text-sm leading-6 text-zinc-600">{item}</p>
          ))}
        </div>
        <ul aria-label={t.workshop.focusLabel} class="mt-8 flex flex-wrap gap-2">
          {t.workshop.focus.map((item) => (
            <li class="font-mono-display rounded border border-zinc-200 px-2.5 py-1.5 text-[0.7rem] text-zinc-600">{item}</li>
          ))}
        </ul>
        <p class="mt-8 border-t border-zinc-200 pt-6 text-sm italic leading-6 text-zinc-500">{t.workshop.privacy}</p>
      </div>
    </div>
  </section>

  <section id="projects" class="bg-zinc-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading title={t.projects.title} />

      <div>
        <div class="mb-7 flex flex-col gap-2 border-b border-zinc-200 pb-4 sm:flex-row sm:items-end sm:justify-between">
          <h3 class="text-xl font-semibold tracking-[-0.025em] text-zinc-950">{t.projects.schoolTitle}</h3>
          <p class="font-mono-display text-xs text-zinc-500">{localizedSchoolProjects.length.toString().padStart(2, '0')} {t.projects.countLabel}</p>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-2">
          {localizedSchoolProjects.map((project) => (
            <ProjectCard
              title={project.title}
              category={project.category}
              type={project.type}
              tech={project.tech}
              github={project.github}
              description={project.description}
              dates={project.dates}
              status={project.status}
              sourceLabel={t.cards.source}
              technologiesLabel={t.cards.technologies}
            />
          ))}
        </div>
      </div>

      <div class="mt-16 sm:mt-20">
        <div class="mb-7 flex flex-col gap-2 border-b border-zinc-200 pb-4 sm:flex-row sm:items-end sm:justify-between">
          <h3 class="text-xl font-semibold tracking-[-0.025em] text-zinc-950">{t.projects.personalTitle}</h3>
          <p class="font-mono-display text-xs text-zinc-500">{localizedPersonalProjects.length.toString().padStart(2, '0')} {t.projects.countLabel}</p>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-2 lg:grid-cols-3">
          {localizedPersonalProjects.map((project) => (
            <ProjectCard
              title={project.title}
              category={project.category}
              type={project.type}
              tech={project.tech}
              github={project.github}
              description={project.description}
              dates={project.dates}
              status={project.status}
              sourceLabel={t.cards.source}
              technologiesLabel={t.cards.technologies}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="border-y border-zinc-200 bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <SectionHeading title={t.skills.title} />
      <div class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.skills.groups.map((group) => <SkillGroup title={group.title} skills={[...group.skills]} />)}
      </div>
    </div>
  </section>

  <section id="resume" class="bg-zinc-50 py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 sm:px-8 lg:grid-cols-[1fr_auto] lg:px-10">
      <div class="max-w-3xl">
        <p class="font-mono-display mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#D52200]">{t.resume.eyebrow}</p>
        <h2 class="text-3xl font-semibold tracking-[-0.035em] text-zinc-950">{t.resume.title}</h2>
        <p class="mt-4 leading-7 text-zinc-600">{t.resume.intro}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={primaryResume} target="_blank" rel="noopener noreferrer" hreflang={primaryResumeLanguage} class="inline-flex min-h-11 items-center justify-center rounded-md bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#FF2800] hover:text-zinc-950">{t.resume.view}</a>
        <a href={primaryResume} download={primaryResumeFilename} hreflang={primaryResumeLanguage} class="inline-flex min-h-11 items-center justify-center rounded-md border border-zinc-300 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-800 transition-colors hover:border-[#FF2800] hover:bg-[#FF2800] hover:text-zinc-950">{t.resume.download}</a>
        <a href={alternateResume} target="_blank" rel="noopener noreferrer" hreflang={alternateResumeLanguage} class="inline-flex min-h-11 items-center justify-center rounded-md border border-zinc-300 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-800 transition-colors hover:border-[#FF2800] hover:bg-[#FF2800] hover:text-zinc-950">{t.resume.viewAlternate}</a>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-zinc-950 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">{t.contact.title}</h2>
          <p class="mt-5 text-base leading-7 text-zinc-400">{t.contact.intro}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:djgregoriotorres@gmail.com" class="inline-flex min-h-11 items-center justify-center rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-[#FF2800]">{t.contact.email}</a>
          <a href="https://www.linkedin.com/in/danielgregoriotorres" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-md border border-zinc-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-[#FF2800] hover:bg-[#FF2800] hover:text-zinc-950">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
