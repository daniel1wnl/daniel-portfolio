---
interface Props {
  title: string;
  skills: string[];
}

const { title, skills } = Astro.props;
---

<article class="border-t border-zinc-300 py-5">
  <h3 class="text-base font-semibold tracking-[-0.02em] text-zinc-950">{title}</h3>
  <ul class="mt-4 flex flex-wrap gap-2">
    {skills.map((skill) => (
      <li class="font-mono-display rounded border border-zinc-200 bg-white px-2.5 py-1.5 text-[0.7rem] text-zinc-600">{skill}</li>
    ))}
  </ul>
</article>
