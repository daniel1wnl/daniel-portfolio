---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const {
  locale = 'en',
  title = getTranslations(locale).meta.title,
  description = getTranslations(locale).meta.description,
} = Astro.props;

const canonicalPath = locale === 'es' ? '/es/' : '/';
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const englishUrl = new URL('/', Astro.site ?? Astro.url.origin);
const spanishUrl = new URL('/es/', Astro.site ?? Astro.url.origin);
const openGraphLocale = locale === 'es' ? 'es_ES' : 'en_US';
const t = getTranslations(locale);
---

<!doctype html>
<html lang={locale} class="scroll-smooth bg-zinc-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:site_name" content="Daniel Gregorio-Torres" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-50 text-zinc-900">
    <a href="#main-content" class="sr-only fixed left-4 top-4 z-[100] rounded bg-white px-4 py-3 font-medium text-zinc-950 shadow transition-colors hover:bg-[#FF2800] focus:not-sr-only">{t.skipToContent}</a>
    <Header locale={locale} />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
